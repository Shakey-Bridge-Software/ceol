;; L:1/8 cheat sheet (2/4 = 4 eighth notes per bar)
;; Quaver (eighth)      ♩ beamed or single flag    = G
;; Dotted quaver        ♩. beamed/flag + dot       = G3/2
;; Semiquaver (16th)    ♬ double flag/beam         = G/2
;; Crotchet (quarter)   ♩ plain stem, no flag/beam = G2
;; Dotted crotchet      ♩. plain stem + dot        = G3
;; Minim (hollow)                                  = A4
;; Dotted minim (hollow + dot)                     = A6
;;
;; Dotted shorthand (hornpipe feel / scotch snap)
;; G>A  = dotted quaver + semiquaver              = G3/2A/2
;; G<A  = semiquaver + dotted quaver              = G/2A3/2
;;
;; Triplets
;; (3ABC = 3 notes in the time of 2 (no closing bracket)
;; (3A/2A/2A = semiquaver + semiquaver + quaver triplet
;;
;; Accidentals
;; ^c = C#   _c = Cb   =c = C natural (override key sig)
